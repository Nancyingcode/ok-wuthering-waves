+fn managed_names(repository: &git2::Repository) -> Result<Vec<String>> {
+    let mut names = Vec::new();
+    for entry in repository.index()?.iter() {
+        if entry.mode != 0o100644 && entry.mode != 0o100755 {
+            anyhow::bail!("Unsupported managed repository file type");
+        }
+        let name = std::str::from_utf8(&entry.path)?.to_string();
+        let root = name.split('/').next().unwrap_or("").to_ascii_lowercase();
+        if name == MANAGED_FILES { anyhow::bail!("Reserved managed repository path"); }
+        if !["configs", "ok_tasks", "ok_import", "logs", "cache", "screenshots"].contains(&root.as_str()) {
+            names.push(name);
+        }
+    }
+    names.sort();
+    Ok(names)
+}
+
+fn managed_path(root: &Path, name: &str) -> Result<PathBuf> {
+    let unsafe_name = name.is_empty() || name.contains('\\') || name.contains(':')
+        || name.split('/').any(|part| part.is_empty() || part == "." || part == "..");
+    if unsafe_name || Path::new(name).is_absolute() {
+        anyhow::bail!("Unsafe managed path: {}", name);
+    }
+    let mut current = root.to_path_buf();
+    for ancestor in current.ancestors() {
+        if fs::symlink_metadata(ancestor).is_ok_and(|metadata| is_managed_link(&metadata)) {
+            anyhow::bail!("Linked managed directory");
+        }
+    }
+    for part in name.split('/') {
+        current.push(part);
+        if fs::symlink_metadata(&current).is_ok_and(|metadata| is_managed_link(&metadata)) {
+            anyhow::bail!("Linked managed path: {}", name);
+        }
+    }
+    Ok(current)
+}
