+import importlib.metadata
+from pathlib import Path
+import re
+import subprocess
+import sys
+import sysconfig
+
+
+QT_PACKAGES = {"ok-pyside-minimal", "pyside6", "pyside6-addons", "pyside6-essentials", "shiboken6"}
+FULL_QT = {"pyside6", "pyside6-addons", "pyside6-essentials"}
+
+
+def canonical_name(name):
+    return re.sub(r"[-_.]+", "-", name).lower()
+
+
+def qt_packages_to_remove(requirements, installed):
+    requested = set()
+    for line in requirements.splitlines():
+        match = re.match(r"^\s*([A-Za-z0-9][A-Za-z0-9_.-]*)(?=\s|\[|[<>=!~;@]|$)", line)
+        if match:
+            requested.add(canonical_name(match[1]))
+    wants_full = bool(requested & FULL_QT)
+    wants_minimal = "ok-pyside-minimal" in requested
+    if wants_full and wants_minimal:
+        raise ValueError("Requirements contain conflicting Qt providers")
+    installed = {canonical_name(name) for name in installed}
+    conflicting = (wants_full and "ok-pyside-minimal" in installed) or (
+        wants_minimal and bool(installed & FULL_QT)
+    )
+    if not conflicting:
+        return []
+    # Both distributions own PySide6 files. Remove the entire Qt group before
+    # reinstalling, or pip can keep metadata for files removed by the other owner.
+    # Retire this reconciliation when profiles no longer share a Python install.
+    return sorted(installed & QT_PACKAGES)
+
+
+def main():
+    spec = sys.argv[1]
+    requirements = Path(spec).read_text(encoding="utf-8-sig") if spec.endswith(".txt") else spec
+    installed = [dist.metadata["Name"] for dist in importlib.metadata.distributions(
+        path=[sysconfig.get_path("purelib")]
+    ) if dist.metadata["Name"]]
+    obsolete = qt_packages_to_remove(requirements, installed)
+    if obsolete:
+        print("Reconciling conflicting Qt providers: " + ", ".join(obsolete), flush=True)
+        subprocess.check_call([sys.executable, "-I", "-m", "pip", "uninstall", "--yes", *obsolete])
+
+
+if __name__ == "__main__":
+    main()
