+fn proxy_bypasses_host(host: &str, port: u16, bypass: &str) -> bool {
+    bypass.split([';', ',']).any(|entry| {
+        let entry = entry.trim();
+        if entry.eq_ignore_ascii_case("<local>") {
+            return !host.contains('.');
+        }
+        if entry.is_empty() {
+            return false;
+        }
+        let target = if entry.contains(':') { format!("{host}:{port}") } else { host.to_string() };
+        let pattern = regex::escape(entry).replace("\\*", ".*").replace("\\?", ".");
+        Regex::new(&format!("(?i)^{pattern}$")).is_ok_and(|pattern| pattern.is_match(&target))
+    })
+}
