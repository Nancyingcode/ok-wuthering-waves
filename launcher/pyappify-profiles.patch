+fn select_windows_proxy(remote_url: &str, server: &str, bypass: &str) -> Option<String> {
+    let remote = reqwest::Url::parse(remote_url).ok()?;
+    if !matches!(remote.scheme(), "http" | "https") {
+        return None;
+    }
+    let host = remote.host_str()?;
+    if proxy_bypasses_host(host, remote.port_or_known_default()?, bypass) {
+        return None;
+    }
+    let server = server.trim();
+    let selected = if server.contains('=') {
+        server.split(';').find_map(|entry| {
+            let (scheme, value) = entry.trim().split_once('=')?;
+            scheme.trim().eq_ignore_ascii_case(remote.scheme()).then_some(value.trim())
+        })?
+    } else {
+        server
+    };
+    if selected.is_empty() { return None; }
+    let proxy = if selected.contains("://") { selected.to_string() } else { format!("http://{selected}") };
+    let parsed = reqwest::Url::parse(&proxy).ok()?;
+    (matches!(parsed.scheme(), "http" | "https") && parsed.host_str().is_some()).then_some(proxy)
+}
