+#[cfg(windows)]
+fn windows_system_proxy(remote_url: &str) -> Option<String> {
+    use windows_sys::Win32::System::Registry::{RegGetValueW, HKEY_CURRENT_USER, RRF_RT_REG_DWORD, RRF_RT_REG_SZ};
+    let key: Vec<u16> = "Software\\Microsoft\\Windows\\CurrentVersion\\Internet Settings\0".encode_utf16().collect();
+    let enabled_name: Vec<u16> = "ProxyEnable\0".encode_utf16().collect();
+    let mut enabled = 0u32;
+    let mut size = std::mem::size_of_val(&enabled) as u32;
+    // libgit2 AUTO checks Git/environment settings, but not the Windows user's
+    // Internet Settings. Read them without changing global or process settings.
+    let status = unsafe { RegGetValueW(HKEY_CURRENT_USER, key.as_ptr(), enabled_name.as_ptr(), RRF_RT_REG_DWORD,
+        std::ptr::null_mut(), (&mut enabled as *mut u32).cast(), &mut size) };
+    if status != 0 || enabled == 0 { return None; }
+    let read_string = |name: &str| -> Option<String> {
+        let name: Vec<u16> = name.encode_utf16().chain(Some(0)).collect();
+        let mut bytes = 0u32;
+        let status = unsafe { RegGetValueW(HKEY_CURRENT_USER, key.as_ptr(), name.as_ptr(), RRF_RT_REG_SZ,
+            std::ptr::null_mut(), std::ptr::null_mut(), &mut bytes) };
+        if status != 0 || bytes == 0 || bytes > 65536 { return None; }
+        let mut value = vec![0u16; (bytes as usize + 1) / 2];
+        let status = unsafe { RegGetValueW(HKEY_CURRENT_USER, key.as_ptr(), name.as_ptr(), RRF_RT_REG_SZ,
+            std::ptr::null_mut(), value.as_mut_ptr().cast(), &mut bytes) };
+        if status != 0 { return None; }
+        let end = value.iter().position(|&c| c == 0).unwrap_or(value.len());
+        String::from_utf16(&value[..end]).ok()
+    };
+    select_windows_proxy(remote_url, &read_string("ProxyServer")?, &read_string("ProxyOverride").unwrap_or_default())
+}
