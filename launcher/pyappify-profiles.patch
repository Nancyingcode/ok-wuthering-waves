+fn recover_unborn_repository_head(repo: &Repository) -> Result<()> {
+    match repo.head() {
+        Ok(_) => return Ok(()),
+        Err(error) if error.code() == ErrorCode::UnbornBranch => {},
+        Err(error) => return Err(error).context("Failed to inspect repository HEAD"),
+    }
+    let versions = get_sorted_tags_by_time(repo)?;
+    let version = versions.iter().find(|tag| is_release_version(tag)).or_else(|| versions.first());
+    let Some(version) = version else { return Ok(()); };
+    let commit = repo.revparse_single(&format!("refs/tags/{version}"))?.peel_to_commit()?;
+    // An interrupted first clone has objects after retrying fetch, but no local
+    // branch. Setup needs a valid HEAD before it can select and install a tag.
+    repo.set_head_detached(commit.id()).context("Failed to initialize interrupted clone HEAD")?;
+    Ok(())
