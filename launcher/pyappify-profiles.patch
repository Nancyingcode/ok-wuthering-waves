+    }
+    fs::write(&record, serde_json::to_vec(&pending)?)?;
+    for name in previous.iter().filter(|name| !current_set.contains(name)) {
+        let root = name.split('/').next().unwrap_or("").to_ascii_lowercase();
+        if ["configs", "ok_tasks", "ok_import", "logs", "cache", "screenshots"].contains(&root.as_str()) { continue; }
+        let filename = managed_path(destination, name)?;
+        if filename.is_file() { fs::remove_file(&filename)?; }
+        let mut parent = filename.parent();
+        while let Some(folder) = parent.filter(|folder| *folder != destination) {
+            if fs::remove_dir(folder).is_err() { break; }
+            parent = folder.parent();
+        }
+    }
+    for name in &current {
+        let from = managed_path(source, name)?;
+        let to = managed_path(destination, name)?;
+        fs::create_dir_all(to.parent().context("Managed file has no parent")?)?;
+        copy_file_with_retry(&from, &to)?;
+    }
+    fs::write(record, serde_json::to_vec(&current)?)?;
+    Ok(())
+}
 
