+pub fn sync_managed_repository_files(repository: &git2::Repository, destination: &Path) -> Result<()> {
+    let source = repository.workdir().context("Repository has no working directory")?;
+    fs::create_dir_all(destination)?;
+    let record = managed_path(destination, MANAGED_FILES)?;
+    let previous: Vec<String> = if record.exists() {
+        serde_json::from_slice(&fs::read(&record)?)?
+    } else {
+        Vec::new()
+    };
+    let current = managed_names(repository)?;
+    let current_set: HashSet<_> = current.iter().collect();
+    // Retain the union until every operation succeeds, so a failed first sync is
+    // recoverable without deleting user data or forgetting partially copied files.
+    let mut pending = previous.clone();
+    pending.extend(current.clone());
+    pending.sort();
+    pending.dedup();
+    for name in &pending {
+        if name == MANAGED_FILES { anyhow::bail!("Reserved managed repository path"); }
