+pub fn copy_repository_files_sync(repository: &git2::Repository, destination: &Path) -> Result<()> {
+    let source = repository.workdir().context("Repository has no working directory")?;
+    let index = repository.index().context("Failed to read repository index")?;
+    let mut tracked_paths = HashSet::new();
+    for entry in index.iter() {
+        let path = PathBuf::from(std::str::from_utf8(&entry.path)?);
+        for ancestor in path.ancestors() {
+            if !ancestor.as_os_str().is_empty() {
+                tracked_paths.insert(ancestor.to_path_buf());
+            }
+        }
+    }
+
+    copy_dir_recursive_filtered_sync(source, destination, &[".git"], &|relative_path| {
+        // Ignore rules apply to untracked files. Tracked modules and their parent
+        // directories must reach the application even when an ignore rule matches.
+        if tracked_paths.contains(relative_path) {
+            return false;
+        }
+        match repository.status_should_ignore(relative_path) {
+            Ok(ignored) => ignored,
+            Err(error) => {
+                warn!("Could not read ignore status for {}: {}. Copying it.", relative_path.display(), error);
+                false
+            }
+        }
+    })?;
+    Ok(())
+}
