--- a/onnxocr/openvino_config.py
+++ b/onnxocr/openvino_config.py
@@ -0,0 +1,41 @@
+"""Strict, device-specific OpenVINO configuration; no silent property fallback."""
+
+from copy import deepcopy
+
+
+class OpenVINOConfigError(ValueError):
+    pass
+
+
+def compile_configs(value):
+    if value is None:
+        return {}
+    if not isinstance(value, dict) or set(value) - {'CPU', 'NPU'}:
+        raise OpenVINOConfigError('openvino_compile_config expects CPU/NPU dictionaries')
+    for device, properties in value.items():
+        if not isinstance(properties, dict):
+            raise OpenVINOConfigError(f'{device} compile config must be a dictionary')
+        for key, option in properties.items():
+            if not isinstance(key, str) or not key:
+                raise OpenVINOConfigError('Compile property keys must be nonempty strings')
+            if key == 'CPU_RUNTIME_CACHE_CAPACITY':
+                if device != 'CPU' or type(option) is not int or option < 0:
+                    raise OpenVINOConfigError('CPU_RUNTIME_CACHE_CAPACITY requires a nonnegative CPU integer')
+    return deepcopy(value)
+
+
+def validate_params(params, defaults):
+    unknown = set(params) - set(defaults) - {'openvino_compile_config'}
+    if unknown:
+        raise ValueError(f'Unknown OCR parameters: {sorted(unknown)}')
+    for key, value in params.items():
+        if key == 'openvino_compile_config':
+            compile_configs(value)
+            continue
+        default = defaults.get(key)
+        if default is not None and type(value) is not type(default):
+            raise ValueError(f'OCR parameter {key} expects {type(default).__name__}')
+    for key in ('rec_batch_num', 'cls_batch_num', 'openvino_num_requests'):
+        value = params.get(key, defaults.get(key, 1))
+        if type(value) is not int or value <= 0:
+            raise ValueError(f'{key} must be a positive integer')
